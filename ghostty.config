# Ghostty config — see https://ghostty.org/docs/config/reference
# Regenerate/apply via dotfiles setup.sh (symlinked to ~/.config/ghostty/config).

# --- Theme ---
# Swap with one line if you want to try alternatives, e.g.:
#   theme = Dracula
#   theme = Catppuccin Mocha
#   theme = GitHub Dark High Contrast
theme = Vesper

# Auto-correct low-contrast foreground/background combos (WCAG-style ratio,
# 1 = off, 21 = max). Fixes weak spots in ANY theme (e.g. ANSI blue against a
# dark background is a common offender) without hand-tuning individual colors.
minimum-contrast = 2

# --- Font ---
# Nerd Font glyphs are used by tmux status lines, herdr's sidebar, and most
# agent-CLI prompts. Requires installing one, e.g.:
#   brew install --cask font-jetbrains-mono-nerd-font
font-family = JetBrainsMono Nerd Font
font-size = 15

# --- Scrollback ---
# Long AI agent transcripts and build logs need more than Ghostty's 10000-line
# default.
scrollback-limit = 100000

# --- Shell integration ---
# Cursor shape changes with shell mode, sudo highlighting, and window title
# tracking — useful for scanning where one command/agent turn ends and the
# next begins.
shell-integration = detect
shell-integration-features = cursor,sudo,title

# --- Clipboard ---
# Ghostty's default only copies a selection to the X11-style "selection"
# clipboard, which macOS doesn't have — so nothing landed in the system
# clipboard the way iTerm2 always did. `clipboard` copies to both.
copy-on-select = clipboard

# --- Safety ---
# Long-running AI agents live in these panes; don't let an accidental
# Cmd+W/Cmd+Q silently kill one.
confirm-close-surface = always

# --- Split focus ---
# Dim unfocused splits so it's obvious which pane has focus when using
# Ghostty's native splits (independent of tmux panes).
unfocused-split-opacity = 0.5
