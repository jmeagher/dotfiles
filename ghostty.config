theme = Vesper

# Auto-fix low-contrast combos (WCAG-style ratio: 1=off, 21=max).
minimum-contrast = 2

font-family = JetBrainsMono Nerd Font
font-size = 15

# Scrollback in bytes for long AI agent transcripts and build logs.
scrollback-limit = 100000000

# Cursor shape, sudo highlighting, window title tracking, and SSH environment.
shell-integration = detect
shell-integration-features = cursor,sudo,title,ssh-env,ssh-terminfo

# Ghostty's default only copies to X11 "selection" clipboard; macOS needs `clipboard` to reach system clipboard.
copy-on-select = clipboard
macos-option-as-alt = true

# Prevent accidental Cmd+W/Cmd+Q from killing long-running agents.
confirm-close-surface = always
window-save-state = always
