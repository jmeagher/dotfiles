# Reference: https://ghostty.org/docs/config/reference

theme = Vesper

# Default 1 (off); raises low-contrast foreground colors to at least 2:1.
minimum-contrast = 2

# Defaults: bundled JetBrains Mono, size 13.
font-family = JetBrainsMono Nerd Font
font-size = 15

# Bytes, not lines. Default is 10MB.
scrollback-limit = 100000000

# Default features are cursor,sudo,title; adds SSH terminfo/env propagation.
shell-integration = detect
shell-integration-features = cursor,sudo,title,ssh-env,ssh-terminfo

# Default (true) only fills the selection clipboard, which macOS lacks; this also fills the system clipboard.
copy-on-select = clipboard

# Default is off; makes Option send Alt/Meta.
macos-option-as-alt = true

# Default only confirms when a process is running; always confirm.
confirm-close-surface = always

# Default follows the macOS system setting; always restore windows.
window-save-state = always
